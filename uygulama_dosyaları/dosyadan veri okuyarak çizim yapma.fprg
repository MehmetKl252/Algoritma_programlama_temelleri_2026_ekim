    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="sat&#305;r" type="String" array="False" size=""/>
            <open expression="&quot;ucgen.txt&quot;" mode="read"/>
            <while expression="EOF()=false">
                <read variable="sat&#305;r"/>
                <if expression="sat&#305;r!=&quot;&quot;">
                    <then>
                        <assign variable="i" expression="ToInteger(sat&#305;r)"/>
                        <forward expression="i" pen="down"/>
                        <turn expression="120" rotate="right"/>
                    </then>
                    <else/>
                </if>
            </while>
            <close mode="read"/>
        </body>
    </function>
</flowgorithm>
