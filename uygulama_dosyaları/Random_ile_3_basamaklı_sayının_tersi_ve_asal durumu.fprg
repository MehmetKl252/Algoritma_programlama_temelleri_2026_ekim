<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="random ile olu&#351;an 3 basamakl&#305; say&#305;n&#305;n tersi ve asal durumu"/>
        <attribute name="authors" value="pc"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-20 08:07:40 &#214;S"/>
        <attribute name="created" value="cGM7UENPR1JFVE1FTjsyMDI2LTEwLTIwOzA3OjQwOjM2IMOWUzsyMzg0"/>
        <attribute name="edited" value="cGM7UENPR1JFVE1FTjsyMDI2LTEwLTIwOzA4OjA3OjQwIMOWUzsxOzI0OTE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="dizi" type="Integer" array="True" size="3"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="2" direction="inc" step="1">
                <assign variable="dizi[i]" expression="random(9)"/>
            </for>
            <output expression="&quot;Say&#305;=&quot;&amp;dizi[0]&amp;dizi[1]&amp;dizi[2]" newline="True"/>
            <output expression="&quot;Tersi=&quot;&amp;dizi[2]&amp;dizi[1]&amp;dizi[0]" newline="True"/>
            <output expression="&quot;Basamak de&#287;eri toplam&#305;=&quot;&amp;dizi[0]+dizi[1]+dizi[2]" newline="True"/>
            <for variable="i" start="0" end="2" direction="inc" step="1">
                <if expression="dizi[i]%2==0 or dizi[i]==0 or dizi[i]==1">
                    <then/>
                    <else>
                        <output expression="&quot;asal=&quot;&amp;dizi[i]" newline="True"/>
                    </else>
                </if>
            </for>
        </body>
    </function>
</flowgorithm>
