    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="gelir, gider" type="Integer" array="False" size=""/>
            <input variable="gelir"/>
            <input variable="gider"/>
            <if expression="gelir=gider">
                <then>
                    <output expression="&quot;gelir gidere e&#351;ittir. kar=0&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="gelir&gt;gider">
                        <then>
                            <output expression="&quot;kar=&quot;&amp;gelir-gider" newline="True"/>
