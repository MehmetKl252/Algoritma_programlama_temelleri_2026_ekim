<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="say&#305; basamak de&#287;erleri toplam&#305;"/>
        <attribute name="authors" value="pc"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-13 06:56:52 &#214;S"/>
        <attribute name="created" value="cGM7UENPR1JFVE1FTjsyMDI2LTEwLTEzOzA2OjQ4OjE1IMOWUzsyMzkw"/>
        <attribute name="edited" value="cGM7UENPR1JFVE1FTjsyMDI2LTEwLTEzOzA2OjU2OjUyIMOWUzsxOzI0OTg="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="s, k, i, t" type="Integer" array="False" size=""/>
            <input variable="s"/>
            <assign variable="t" expression="0"/>
            <assign variable="k" expression="0"/>
            <assign variable="i" expression="1"/>
            <while expression="s&gt;0">
                <assign variable="k" expression="s mod 10"/>
                <assign variable="t" expression="t+k"/>
                <assign variable="s" expression="s/10"/>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;Toplam=&quot;&amp;t" newline="True"/>
        </body>
    </function>
</flowgorithm>
