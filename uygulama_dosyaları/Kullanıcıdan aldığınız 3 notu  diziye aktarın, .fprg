    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, t, i" type="Integer" array="False" size=""/>
            <assign variable="t" expression="0"/>
            <declare name="dizi" type="Integer" array="True" size="3"/>
            <for variable="i" start="0" end="2" direction="inc" step="1">
                <input variable="dizi[i]"/>
                <assign variable="t" expression="t+dizi[i]"/>
            </for>
            <output expression="&quot;toplam=&quot;&amp;t" newline="True"/>
            <output expression="&quot;ortalama=&quot;&amp;t/3" newline="True"/>
        </body>
    </function>
</flowgorithm>
