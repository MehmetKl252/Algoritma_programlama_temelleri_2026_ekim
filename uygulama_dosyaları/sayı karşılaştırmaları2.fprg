                <then>
                    <output expression="&quot;ilk say&#305; b&#252;y&#252;k&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="b&gt;a and b&gt;c">
                        <then>
                            <output expression="&quot;ikinci say&#305; b&#252;y&#252;k&quot;" newline="True"/>
                        </then>
                        <else>
