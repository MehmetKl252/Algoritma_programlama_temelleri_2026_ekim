<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="&#231;ift say&#305; toplam&#305;"/>
        <attribute name="authors" value="pc"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-15 02:08:33 &#214;S"/>
        <attribute name="created" value="cGM7UENPR1JFVE1FTjsyMDI2LTA2LTE1OzAxOjI0OjEyIMOWUzsyMzgz"/>
        <attribute name="edited" value="cGM7UENPR1JFVE1FTjsyMDI2LTA2LTE1OzAyOjA4OjMzIMOWUzsxOzI0OTc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="s, i, t" type="Integer" array="False" size=""/>
            <assign variable="t" expression="0"/>
            <assign variable="i" expression="1"/>
            <input variable="s"/>
            <while expression="i&lt;=s">
                <if expression="i%2=0">
                    <then>
                        <output expression="i" newline="True"/>
                        <assign variable="t" expression="t+i"/>
                    </then>
                    <else/>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;Toplam=&quot;&amp;t" newline="True"/>
        </body>
    </function>
</flowgorithm>
