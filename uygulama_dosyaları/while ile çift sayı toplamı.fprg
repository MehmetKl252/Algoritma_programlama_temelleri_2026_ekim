<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="while artan algoritma"/>
        <attribute name="authors" value="pc"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-06-09 03:59:27 &#214;S"/>
        <attribute name="created" value="cGM7UENPR1JFVE1FTjsyMDI2LTA2LTA5OzAyOjIyOjM3IMOWUzsyMzky"/>
        <attribute name="edited" value="cGM7UENPR1JFVE1FTjsyMDI2LTA2LTA5OzAzOjU5OjI3IMOWUzsyOzI1MTE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="s, i, ctopla" type="Integer" array="False" size=""/>
            <assign variable="i" expression="1"/>
            <assign variable="ctopla" expression="0"/>
            <input variable="s"/>
            <while expression="i&lt;=s">
                <if expression="i%2=0">
                    <then>
                        <output expression="i" newline="True"/>
                        <assign variable="ctopla" expression="ctopla+i"/>
                    </then>
                    <else/>
                </if>
                <assign variable="i" expression="i+1"/>
            </while>
            <output expression="&quot;Toplam=&quot;&amp;ctopla" newline="True"/>
        </body>
    </function>
</flowgorithm>
